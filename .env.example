# Local defaults. Production values belong in the hosting provider's private
# environment-variable settings, not in a committed file.
SECRET_KEY=replace-with-a-long-random-secret-key
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost,10.0.2.2
DATABASE_URL=sqlite:///db.sqlite3
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=
SECURE_SSL_REDIRECT=False
TRUST_PROXY_SSL_HEADER=False
SECURE_HSTS_SECONDS=0
MEDIA_ROOT=media

# SendGrid SMTP settings for BluuBase email verification and account recovery.
# Replace the key and sender only after completing the SendGrid setup.
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=replace-with-your-sendgrid-mail-send-api-key
DEFAULT_FROM_EMAIL="BluuBase <replace-with-your-verified-sender-address>"
